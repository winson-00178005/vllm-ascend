[run]
source = vllm_ascend
branch = True
parallel = True
data_file = .coverage.st

[paths]
source =
    vllm_ascend/
    tests/st/

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

omit =
    tests/*
    */__pycache__/*
    */site-packages/*
    */venv/*
    */.venv/*

fail_under = 80
precision = 2
show_missing = True
skip_covered = False

[html]
directory = htmlcov_st
title = vllm-ascend ST Test Coverage

[xml]
output = st-coverage.xml

[json]
output = st-coverage.json
show_contexts = True

[combine]
data_file = .coverage.st